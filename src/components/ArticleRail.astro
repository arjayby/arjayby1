---
import { SectionRail, type SectionRailProps } from "@/components/ui/section-rail";

type Props = Pick<SectionRailProps, "sections" | "ariaLabel">;

const { sections, ariaLabel = "Article sections" } = Astro.props;
---

<SectionRail
  sections={sections}
  ariaLabel={ariaLabel}
  activeMarkerLength="long"
  gap={0}
  className="article-rail"
  client:media="(width > 72rem)"
/>
