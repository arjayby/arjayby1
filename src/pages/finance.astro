---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Finance" description="Personal finance notes from arjayby1.">
  <article class="page-stack">
    <h1 class="page-heading">Finance</h1>

    <div class="copy-stack">
      <p>
        This page will collect simple personal finance notes and experiments.
        The figures below are placeholders only.
      </p>
    </div>

    <dl class="metric-list">
      <div>
        <dt>Monthly review</dt>
        <dd>Pending</dd>
      </div>
      <div>
        <dt>Savings note</dt>
        <dd>00%</dd>
      </div>
      <div>
        <dt>Last updated</dt>
        <dd>Sep 2026</dd>
      </div>
    </dl>
  </article>
</BaseLayout>
