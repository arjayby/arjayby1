---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TooltipLink from "@/components/TooltipLink";

const kousaImages = [
  { src: "/images/kousa/chrome-bloom.webp", alt: "Chrome flower sculpture" },
  { src: "/images/kousa/glass-hare.webp", alt: "Glass hare sculpture" },
  { src: "/images/kousa/iridescent-film.webp", alt: "Iridescent film" },
  { src: "/images/kousa/burgundy-roses.webp", alt: "Burgundy roses" },
  { src: "/images/kousa/teal-fabric.webp", alt: "Teal fabric folds" },
  { src: "/images/kousa/desert-arch.webp", alt: "Desert arch" },
  { src: "/images/kousa/sculpted-sneaker.webp", alt: "Sculpted sneaker" },
  { src: "/images/kousa/distorted-fox.webp", alt: "Distorted fox portrait" },
  { src: "/images/kousa/sea-cave.webp", alt: "Sea cave" },
  { src: "/images/kousa/amber-fragrance.webp", alt: "Amber fragrance bottle" },
  { src: "/images/kousa/moss-stream.webp", alt: "Mossy stream" },
  { src: "/images/kousa/coral-fan.webp", alt: "Coral fan" },
];
---

<BaseLayout
  title="Home"
  description="The personal developer portfolio of arjayby1."
>
  <article class="page-stack">
    <div class="page-content">
      <h1 class="home-heading">
        Arjay Bayona - Software Dev / Product Builder
      </h1>
      <div class="copy-stack">
        <p>
          I build design tools and AI products. I care a lot about how they look
          and feel.
        </p>
        <p>
          These days, I'm exploring better agentic development workflows and
          agentic payments with x402 while building <TooltipLink
            href="https://www.kousa.app"
            client:load>Kousa</TooltipLink
          >, a node-based studio for generating and connecting AI media.
        </p>
        <p>
          Peaked Masters rank in both <TooltipLink
            href="https://www.ea.com/games/apex-legends"
            client:load>Apex</TooltipLink
          > and <TooltipLink href="https://www.leagueoflegends.com/" client:load
            >League</TooltipLink
          >.
        </p>
      </div>

      <div class="recent-content">
        <section aria-labelledby="recent-writing-heading">
          <h2 id="recent-writing-heading">
            <a href="/writing">Recent writing</a>
          </h2>
          <div class="entry-groups">
            <div class="entry-group" role="group" aria-label="September 2026">
              <ul class="entry-list">
                <li>
                  <time datetime="2026-09">Sep 2026</time>
                  <a href="/writing/my-current-agentic-software-development-workflow">
                    My current agentic software development workflow
                  </a>
                </li>
                <li>
                  <a href="/writing/unslop-your-copy">Unslop your copy</a>
                </li>
              </ul>
            </div>
          </div>
        </section>

        <section aria-labelledby="recent-finance-heading">
          <h2 id="recent-finance-heading">
            <a href="/finance">Recent finance</a>
          </h2>
          <div class="entry-groups">
            <div class="entry-group" role="group" aria-label="September 2026">
              <ul class="entry-list">
                <li>
                  <time datetime="2026-09">Sep 2026</time>
                  <a href="/finance/how-i-made-4700-in-one-month-trading-crypto">
                    How I made $4,700 in one month trading crypto
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </section>
      </div>

      <section class="kousa-gallery" aria-labelledby="kousa-gallery-heading">
        <h2 id="kousa-gallery-heading">Gallery</h2>
        <p>Images I've generated for production work and personal projects.</p>
        <ul tabindex="0" aria-label="Kousa image gallery">
          {
            kousaImages.map(({ src, alt }) => (
              <li>
                <img
                  src={src}
                  alt={alt}
                  width="768"
                  height="768"
                  loading="lazy"
                />
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>
