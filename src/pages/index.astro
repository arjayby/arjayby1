---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TooltipLink from "@/components/TooltipLink";
---

<BaseLayout
  title="Home"
  description="The personal developer portfolio of arjayby1."
>
  <article class="page-stack">
    <div class="page-content">
      <h1 class="home-heading">
        Arjay Bayona - Software Dev / Product Builder
      </h1>
      <div class="copy-stack">
        <p>
          I build design tools and AI products. I care a lot about how they look
          and feel.

          <p>
            These days, I'm exploring better agentic development workflows and
            agentic payments with x402 while building <TooltipLink
              href="https://www.kousa.app"
              client:load>Kousa</TooltipLink
            >, a node-based studio for generating and connecting AI media
          </p>
          <p>
            Peaked Masters rank in both <TooltipLink
              href="https://www.ea.com/games/apex-legends"
              client:load>Apex</TooltipLink
            > and <TooltipLink
              href="https://www.leagueoflegends.com/"
              client:load>League</TooltipLink
            >.
          </p>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
