---
import { Image } from "astro:assets";
import fibonacciSettings from "@/assets/finance/fibonacci-settings.png";
import limitOrderOneDiagram from "@/assets/finance/limit-order-one-diagram.png";
import limitOrderThreeDiagram from "@/assets/finance/limit-order-three-diagram.png";
import limitOrderTwoDiagram from "@/assets/finance/limit-order-two-diagram.png";
import longLimitOne from "@/assets/finance/long-limit-one.png";
import longLimitThree from "@/assets/finance/long-limit-three.png";
import longLimitTwo from "@/assets/finance/long-limit-two.png";
import shortLimitOne from "@/assets/finance/short-limit-one.png";
import shortLimitThree from "@/assets/finance/short-limit-three.png";
import shortLimitTwo from "@/assets/finance/short-limit-two.png";
import ArticleRail from "@/components/ArticleRail.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const sections = [
  { id: "strategy-overview", label: "How I trade this setup" },
  { id: "dca-method", label: "My three limit orders" },
  { id: "fibonacci-levels", label: "Fibonacci levels" },
  { id: "entry-confirmations", label: "What I check before entering" },
  { id: "position-sizing", label: "How much I risked" },
  { id: "risking-five", label: "When the third limit fills" },
  { id: "win-rate-checklist", label: "My setup checklist" },
  { id: "disclaimer-resources", label: "Disclaimer and learning resources" },
  { id: "trading-tools", label: "Trading tools" },
];

const limitOrderDiagrams = [
  {
    image: limitOrderOneDiagram,
    title: "First limit order",
    alt: "TradingView diagram showing the first limit order at the 0.618 Fibonacci level, take profit at 1.272, and stop loss at negative 0.05.",
  },
  {
    image: limitOrderTwoDiagram,
    title: "Second limit order",
    alt: "TradingView diagram showing a second limit order at the 0.382 Fibonacci level and its adjusted take-profit area.",
  },
  {
    image: limitOrderThreeDiagram,
    title: "Third limit order",
    alt: "TradingView diagram showing a third limit order at the 0.17 Fibonacci level with the same stop loss and a lower take-profit area.",
  },
];

const tradeExamples = [
  {
    image: longLimitOne,
    title: "Long position, limit 1 win",
    url: "https://www.tradingview.com/x/oR8WEyXx/",
    alt: "Annotated SOL perpetual chart showing a long trend-continuation trade that won after the first limit order filled.",
  },
  {
    image: longLimitTwo,
    title: "Long position, limit 2 win",
    url: "https://www.tradingview.com/x/qQm4Lo7x/",
    alt: "Annotated SOL perpetual chart showing a long trend-continuation trade that won after the second limit order filled.",
  },
  {
    image: longLimitThree,
    title: "Long position, limit 3 win",
    url: "https://www.tradingview.com/x/5s5Y8f5m/",
    alt: "Annotated SOL perpetual chart showing a long trend-continuation trade that won after the third limit order filled.",
  },
  {
    image: shortLimitOne,
    title: "Short position, limit 1 win",
    url: "https://www.tradingview.com/x/yWW099BI/",
    alt: "Annotated SOL perpetual chart showing a short trend-continuation trade that won after the first limit order filled.",
  },
  {
    image: shortLimitTwo,
    title: "Short position, limit 2 win",
    url: "https://www.tradingview.com/x/xx8TrmUW/",
    alt: "Annotated SOL perpetual chart showing a short trend-continuation trade that won after the second limit order filled.",
  },
  {
    image: shortLimitThree,
    title: "Short position, limit 3 win",
    url: "https://www.tradingview.com/x/mLLShTz5/",
    alt: "Annotated SOL perpetual chart showing a short trend-continuation trade that won after the third limit order filled.",
  },
];
---

<BaseLayout
  title="How I made $4,700 in one month trading crypto"
  description="A September 2024 case study of the high-risk DCA trend continuation strategy I used to 2x my crypto trading account."
  wide
>
  <article class="page-stack writing-article finance-article">
    <ArticleRail sections={sections} />

    <header class="article-header">
      <a class="back-link" href="/finance">Finance</a>
      <div class="article-heading">
        <p class="article-kicker">Case study · September 2024</p>
        <h1>How I made $4,700 in one month trading crypto</h1>
        <p class="article-deck">
          The high-risk DCA trend continuation strategy I used to 2× my account
        </p>
      </div>

      <dl class="finance-results" aria-label="My September 2024 trading results">
        <div>
          <dt>Cumulative P&amp;L</dt>
          <dd>+$4,712.60</dd>
        </div>
        <div>
          <dt>Account return</dt>
          <dd>+114.45%</dd>
        </div>
        <div>
          <dt>Closed positions</dt>
          <dd>20</dd>
        </div>
        <div>
          <dt>Recorded win rate</dt>
          <dd>100%</dd>
        </div>
      </dl>

      <p class="finance-proof-link">
        <a href="/finance/how-i-made-4700-in-one-month-trading-crypto/bybit-proof">
          View the Bybit proof →
        </a>
      </p>

      <aside class="article-note finance-risk-note">
        <p>
          This was my result for September 2024. It doesn't mean I can repeat it every month.
          I traded leveraged crypto derivatives and risked up to 20% of my account per trade.
          A few losses in a row at that size could wipe out a lot of my account.
        </p>
      </aside>
    </header>

    <div class="article-body">
      <section id="strategy-overview" aria-labelledby="strategy-overview-heading">
        <h2 id="strategy-overview-heading">How I trade this setup</h2>
        <p>
          I look for a trend that's already moving, then wait for a pullback to enter.
          The idea is to catch the next move in the same direction.
        </p>
        <p>
          I split the position into three limit orders. That's what I mean by DCA here.
          Each order adds to the same leveraged trade.
        </p>
        <ul class="article-list">
          <li>In an uptrend, I look to buy the pullback after price breaks a significant previous high.</li>
          <li>In a downtrend, I look to sell the bounce after price breaks a significant previous low.</li>
          <li>I wait for the trend, wave position, and EMAs to line up before entering.</li>
        </ul>
        <p>
          See examples of a{" "}
          <a href="https://www.tradingview.com/x/7GjQCPLz/" target="_blank" rel="noreferrer"
            >long continuation ↗</a
          > and a{" "}
          <a href="https://www.tradingview.com/x/p5yMICJu/" target="_blank" rel="noreferrer"
            >short continuation ↗</a
          >.
        </p>
      </section>

      <section id="dca-method" aria-labelledby="dca-method-heading">
        <h2 id="dca-method-heading">My three limit orders</h2>
        <p>
          I draw my Fibonacci levels across the impulse move and place limit orders at 0.618,
          0.382, and 0.17. Each order is larger than the last. My stop stays at -0.05, and I move
          the take-profit target closer as more orders fill.
        </p>

        <div class="strategy-table-wrap wide-block">
          <table class="strategy-table">
            <thead>
              <tr>
                <th scope="col">Order</th>
                <th scope="col">Entry</th>
                <th scope="col">Size</th>
                <th scope="col">Take profit</th>
                <th scope="col">Stop</th>
                <th scope="col">Risk ratio used</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Limit 1</th>
                <td>0.618</td>
                <td>1×</td>
                <td>1.272</td>
                <td>-0.05</td>
                <td>1:1</td>
              </tr>
              <tr>
                <th scope="row">Limit 2</th>
                <td>0.382</td>
                <td>3×</td>
                <td>Just below 0.618</td>
                <td>-0.05</td>
                <td>3:1</td>
              </tr>
              <tr>
                <th scope="row">Limit 3</th>
                <td>0.17</td>
                <td>5×</td>
                <td>Just below 0.382</td>
                <td>-0.05</td>
                <td>5:1</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p>
          Adding more improves my average entry, but it also means a bigger position while price
          is moving against me. The order sizes, targets, and stop all need to be worked out
          before the first order fills.
        </p>

        <div class="diagram-grid wide-block">
          {
            limitOrderDiagrams.map(({ image, title, alt }) => (
              <figure class="finance-figure">
                <button
                  class="image-viewer-trigger"
                  type="button"
                  data-viewer-trigger
                  data-full-src={image.src}
                  data-full-alt={alt}
                  data-full-caption={title}
                  aria-label={`Open ${title.toLowerCase()} diagram at full size`}
                >
                  <Image
                    src={image}
                    alt={alt}
                    widths={[480, 720, 1024, 1600]}
                    sizes="(max-width: 42rem) calc(100vw - 2rem), 21rem"
                    format="webp"
                    loading="lazy"
                  />
                </button>
                <figcaption>{title}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section id="fibonacci-levels" aria-labelledby="fibonacci-levels-heading">
        <h2 id="fibonacci-levels-heading">The Fibonacci template</h2>
        <p>
          These are the levels for my entries, take profit, and stop. Having them on the chart
          makes the plan easier to follow, but price can still go straight through them.
        </p>
        <ul class="article-list">
          <li><strong>0.618</strong> is the first pullback entry.</li>
          <li><strong>0.382</strong> is where I add the second order.</li>
          <li><strong>0.17</strong> is where I add the third and final order.</li>
          <li><strong>1.272</strong> is the first order's take-profit level.</li>
          <li><strong>-0.05</strong> is the stop for all three orders.</li>
        </ul>
        <figure class="finance-figure settings-figure">
          <button
            class="image-viewer-trigger"
            type="button"
            data-viewer-trigger
            data-full-src={fibonacciSettings.src}
            data-full-alt="TradingView Fibonacci retracement settings with 0.05, 0.17, 0.382, 0.5, 0.618, 1, and 1.272 enabled."
            data-full-caption="TradingView Fibonacci retracement settings"
            aria-label="Open the Fibonacci settings screenshot at full size"
          >
            <Image
              src={fibonacciSettings}
              alt="TradingView Fibonacci retracement settings with 0.05, 0.17, 0.382, 0.5, 0.618, 1, and 1.272 enabled."
              widths={[360, 540, 720]}
              sizes="(max-width: 42rem) calc(100vw - 2rem), 24rem"
              format="webp"
              loading="lazy"
            />
          </button>
          <figcaption>The Fibonacci settings for this setup in TradingView.</figcaption>
        </figure>
      </section>

      <section id="entry-confirmations" aria-labelledby="entry-confirmations-heading">
        <h2 id="entry-confirmations-heading">What I check before entering</h2>
        <p>I want all three of these to line up before I take a trade.</p>

        <h3>Long setup</h3>
        <ol class="article-list">
          <li>Price breaks the previous significant high.</li>
          <li>The pullback appears inside the third Elliott wave.</li>
          <li>EMA 20 is above EMA 50, and EMA 50 is above EMA 200.</li>
        </ol>

        <h3>Short setup</h3>
        <ol class="article-list">
          <li>Price breaks the previous significant low.</li>
          <li>The bounce appears inside the third Elliott wave.</li>
          <li>EMA 20 is below EMA 50, and EMA 50 is below EMA 200.</li>
        </ol>

        <p>
          Counting Elliott waves takes some judgment. I look at the wave count alongside the
          previous high or low that broke and how the EMAs line up.
        </p>

        <h3>Six completed examples</h3>
        <p>
          These charts show winning long and short setups after one, two, or three orders filled.
          Click any chart to take a closer look.
        </p>

        <div class="trade-grid wide-block">
          {
            tradeExamples.map(({ image, title, url, alt }) => (
              <figure class="finance-figure trade-figure">
                <button
                  class="image-viewer-trigger"
                  type="button"
                  data-viewer-trigger
                  data-full-src={image.src}
                  data-full-alt={alt}
                  data-full-caption={title}
                  aria-label={`Open ${title.toLowerCase()} chart at full size`}
                >
                  <Image
                    src={image}
                    alt={alt}
                    widths={[640, 960, 1280, 1920]}
                    sizes="(max-width: 42rem) calc(100vw - 2rem), 31rem"
                    format="webp"
                    loading="lazy"
                  />
                </button>
                <figcaption>
                  <span>{title}</span>
                  <a href={url} target="_blank" rel="noreferrer">Open full chart ↗</a>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section id="position-sizing" aria-labelledby="position-sizing-heading">
        <h2 id="position-sizing-heading">How much I risked</h2>
        <p>
          I risked a maximum of 20% of my account per trade, across all three limit orders combined.
          On a $10,000 account, that meant risking up to $2,000 for a $400 target at 5:1 risk.
        </p>
        <aside class="article-note">
          <p>
            That's how much I risked. I'm not suggesting you risk the same amount.
            Start with how much you're willing to lose on a trade.
          </p>
        </aside>
        <p>
          The calculator below works out the order sizes, adjusted targets, and potential profit.
          You enter your account size, the three limit prices, your first target, and your stop.
        </p>
        <p>
          It starts at 10% risk. The original method uses double the account-size input for 20%
          risk, or half for 5%. Check the numbers against your exchange's contract and margin rules
          before placing orders.
        </p>
        <p>
          <a
            href="https://docs.google.com/spreadsheets/d/16-xoM2-JJkOANUb67w9ADrl8J-ZGC7qt7pl5h1fg93I/edit?gid=0#gid=0"
            target="_blank"
            rel="noreferrer"
          >Crypto DCA trend continuation strategy calculator ↗</a>
        </p>
      </section>

      <section id="risking-five" aria-labelledby="risking-five-heading">
        <h2 id="risking-five-heading">When the third limit fills</h2>
        <p>
          When my third limit order fills, that's where I get emotional. My heart starts racing
          because I know one loss could wipe out the profits from five wins.
        </p>
        <p>
          I start thinking about those five wins and how I could give all of that back on this
          one trade. I knew the risk going in, but it's still hard when I'm watching it happen.
        </p>
        <p>
          But I've got to trust my setup and the strategy I chose to follow, even when I'm feeling
          that pressure.
        </p>
      </section>

      <section id="win-rate-checklist" aria-labelledby="win-rate-checklist-heading">
        <h2 id="win-rate-checklist-heading">My setup checklist</h2>

        <h3>Market conditions</h3>
        <ul class="article-list">
          <li>I look for price action and an Elliott-wave structure I can read clearly.</li>
          <li>I avoid extreme volatility, major news, and geopolitical shocks.</li>
          <li>I avoid 8:00–10:00 a.m. Eastern around the New York open.</li>
        </ul>

        <h3>Timeframes and direction</h3>
        <ul class="article-list">
          <li>I check the daily chart for the trend and major levels.</li>
          <li>I decide whether I'm looking for longs or shorts, then look for entries on the 3-minute chart.</li>
        </ul>

        <h3>Levels and review</h3>
        <ul class="article-list">
          <li>Mark prior-day highs and lows, weekly levels, and round numbers.</li>
          <li>Watch for breaks or rejections.</li>
          <li>Backtest every rule.</li>
          <li>Record fills, exits, invalidations, and win rate.</li>
        </ul>
        <p>
          I'm looking for a setup I can read clearly. Sometimes that means waiting.
        </p>
      </section>

      <section id="disclaimer-resources" aria-labelledby="disclaimer-resources-heading">
        <h2 id="disclaimer-resources-heading">Disclaimer and learning resources</h2>
        <p>
          Leveraged crypto trading can cause substantial losses. Past results do not predict future
          performance. Use only money you can afford to lose, check local regulations, and seek
          qualified advice for your circumstances.
        </p>
        <h3>Risk management</h3>
        <ul class="article-list">
          <li><cite>Trading in the Zone</cite> by Mark Douglas</li>
          <li><cite>Technical Analysis of the Financial Markets</cite> by John J. Murphy</li>
        </ul>

        <h3>Further study</h3>
        <ul class="article-list">
          <li>Elliott Wave theory</li>
          <li>Fibonacci trading methods</li>
          <li>Price-action trading</li>
        </ul>
      </section>

      <section id="trading-tools" class="article-references" aria-labelledby="trading-tools-heading">
        <h2 id="trading-tools-heading">Trading tools</h2>
        <ol>
          <li><a href="https://www.tradingview.com/">TradingView charting platform</a></li>
          <li>
            <a href="https://www.bybit.com/invite?ref=BDYKRLN">Bybit exchange referral link</a>.
            Choose an exchange that is available and legal in your country.
          </li>
          <li>
            <a href="https://docs.google.com/spreadsheets/d/16-xoM2-JJkOANUb67w9ADrl8J-ZGC7qt7pl5h1fg93I/edit?gid=0#gid=0"
              >DCA strategy calculator</a
            >
          </li>
          <li>
            <a href="https://catkin-corn-f46.notion.site/Trading-Journal-111d803b72f58044aad4e0d58e1ef831"
              >Notion trading journal</a
            >
          </li>
          <li><a href="https://www.forexfactory.com/">Forex Factory calendar and news</a></li>
          <li><a href="https://edition.cnn.com/">CNN news</a></li>
          <li>
            <a href="https://www.tradingview.com/economic-calendar/">TradingView economic calendar</a>
          </li>
        </ol>
        <p class="finance-updated">Published Sep 2026 · Results recorded Sep 2024</p>
      </section>

      <aside class="finance-disclaimer" aria-label="Financial disclaimer">
        <p>
          The finance content on this site is for educational purposes only. It is not financial
          advice.
        </p>
      </aside>
    </div>
  </article>

</BaseLayout>
